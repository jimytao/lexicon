{
  "identifier": "default",
  "description": "Default capabilities for Lexicon",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-set-background-color",
    "core:window:allow-set-theme",
    "core:window:allow-show",
    "core:window:allow-theme",
    "allow-persist-boot-appearance"
  ]
}

{
  "manifest_version": 3,
  "name": "Lexicon",
  "version": "0.9.22",
  "description": "面向中文母语者的英语单词学习工具 —— 词源、语义情景、母语者用法。",
  "action": { "default_title": "Lexicon" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": ["sidePanel", "storage", "contextMenus"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "lookup-selection": {
      "suggested_key": { "default": "Alt+L", "mac": "Command+Shift+L" },
      "description": "Look up the selected text in Lexicon"
    }
  },
  "host_permissions": [
    "https://api.search.brave.com/*",
    "https://api.tavily.com/*",
    "<all_urls>"
  ],
  "externally_connectable": {
    "ids": ["akkabgjdlehjmfnmjpfkdgmaghdncdol"]
  }
}

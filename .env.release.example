# Copy to `.env.release` (gitignored) and fill in real values.
# Loaded by: scripts/release/Load-ReleaseEnv.ps1

# Tauri updater signing (minisign) — password for src-tauri/lexicon.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Android release keystore — mapped to KEYSTORE_PASSWORD / KEY_PASSWORD for Gradle
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
